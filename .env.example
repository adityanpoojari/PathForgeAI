# ==========================================
# PathForge AI Environment Configuration Example
# Completely Free-to-Run Architecture
# ==========================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-random-secret"

# Rate Limiting (Daily generations per IP or User)
RATE_LIMIT_GUEST_DAILY=5
RATE_LIMIT_USER_DAILY=15

# ------------------------------------------
# AI Provider Configuration (Zero Cost Hierarchy)
# ------------------------------------------
AI_PRIMARY_PROVIDER="gemini"

# (A) Google Gemini (Free Google AI Studio key)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# (B) Groq (Free tier)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"

# (C) OpenRouter (Free models ending in :free)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# (D) Ollama (Local open-source model)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
