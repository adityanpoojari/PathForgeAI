datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String         @id @default(cuid())
  name              String?
  email             String         @unique
  passwordHash      String?
  image             String?
  emailVerified     DateTime?
  role              String         @default("USER") // USER, ADMIN
  twoFactorEnabled  Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts          Account[]
  sessions          Session[]
  learningPaths     LearningPath[]
  progressRecords   Progress[]
  notes             Note[]
  auditLogs         AuditLog[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningPath {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  technologies   String              // Comma-separated list or primary tech
  level          String              // Beginner, Intermediate, Advanced
  goal           String              // Software Developer, etc.
  hoursPerWeek   Int                 @default(10)
  weeks          Int                 @default(8)
  requestHash    String              @unique // SHA256 of params for instant cache lookup
  contentJson    String              // Validated JSON serialized LearningPathOutput
  visibility     String              @default("private") // private, public
  shareId        String              @unique @default(cuid())
  isArchived     Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  modules        Module[]
  projects       Project[]
  problems       PracticeProblem[]
  questions      InterviewQuestion[]
  weeklyPlans    WeeklyPlan[]
  progressRecords Progress[]
  notes          Note[]

  @@index([requestHash])
  @@index([userId])
}

model Module {
  id             String       @id @default(cuid())
  learningPathId String
  order          Int
  title          String
  estimatedHours Int
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  topics         Topic[]
}

model Topic {
  id             String   @id @default(cuid())
  moduleId       String
  title          String
  description    String
  resourcesJson  String   // Serialized array of Resource objects
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Project {
  id              String       @id @default(cuid())
  learningPathId  String
  title           String
  difficulty      String       // beginner, intermediate, advanced, capstone
  description     String
  skillsJson      String       // Serialized array of skill strings
  featuresJson    String       // Serialized array of feature strings
  stretchGoalsJson String      // Serialized array of stretch goal strings
  learningPath    LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model PracticeProblem {
  id             String       @id @default(cuid())
  learningPathId String
  title          String
  difficulty     String       // easy, medium, hard
  topic          String
  hint           String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model InterviewQuestion {
  id             String       @id @default(cuid())
  learningPathId String
  question       String
  answer         String
  difficulty     String
  topic          String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model WeeklyPlan {
  id             String       @id @default(cuid())
  learningPathId String
  week           Int
  focus          String
  tasksJson      String       // Serialized array of task strings
  hours          Int
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model Progress {
  id             String       @id @default(cuid())
  userId         String
  learningPathId String
  itemId         String       // Identifier of the topic, project, or problem
  itemType       String       // "topic" | "project" | "problem"
  completed      Boolean      @default(false)
  completedAt    DateTime?
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId, itemId])
  @@index([userId, learningPathId])
}

model Note {
  id             String       @id @default(cuid())
  userId         String
  learningPathId String
  topicId        String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId, topicId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  event        String   // "LOGIN_SUCCESS", "LOGIN_FAILED", "SIGNUP", "PASSWORD_CHANGE", etc.
  ipAddress    String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RateLimitRecord {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "ip:127.0.0.1:generate" or "user:cuid:login"
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([key, resetAt])
}
